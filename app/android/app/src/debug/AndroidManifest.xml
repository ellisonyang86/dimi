<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- debug 联调放行明文 HTTP（模拟器 10.0.2.2 / 局域网真机）：
         networkSecurityConfig 在 Android N+ 优先于 usesCleartextTraffic，
         两个属性都需用 tools:replace 覆盖为 debug 放行配置 -->
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:usesCleartextTraffic,android:networkSecurityConfig"/>
</manifest>
